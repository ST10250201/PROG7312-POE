@page "/command-stream"
@using System.Net.Http.Json
@using SmartX.Client.Models
@inject HttpClient Http

<PageTitle>Command Stream | Smart-X</PageTitle>

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="fw-bold">Real-Time Command Stream</h1>
            <p class="text-muted mb-0">
                Monitor live sensor telemetry, processing queues,
                critical alerts and recommended actions.
            </p>
        </div>

        <button class="btn btn-primary"
                disabled="@(isLoading || isCommandBusy)"
                @onclick="LoadDashboardAsync">
            @(isLoading ? "Refreshing..." : "Refresh Dashboard")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(commandMessage))
    {
        <div class="alert alert-success" role="status">
            @commandMessage
        </div>
    }

    @if (isLoading && !hasLoaded)
    {
        <div class="alert alert-info">
            Loading Smart-X telemetry dashboard...
        </div>
    }

    <!-- DASHBOARD SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Registered Sensors</p>
                    <h2 class="fw-bold">@sensors.Count</h2>
                    <small class="text-muted">
                        Connected sensor registry
                    </small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Normal Queue</p>
                    <h2 class="fw-bold">
                        @processingStatus.NormalQueueCount
                    </h2>
                    <small class="text-muted">
                        Pending FIFO telemetry jobs
                    </small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Critical Queue</p>
                    <h2 class="fw-bold text-danger">
                        @processingStatus.CriticalQueueCount
                    </h2>
                    <small class="text-muted">
                        Pending high-priority jobs
                    </small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Active Alerts</p>
                    <h2 class="fw-bold text-warning">
                        @processingStatus.ActiveAlerts.Count
                    </h2>
                    <small class="text-muted">
                        Unique critical sensor alerts
                    </small>
                </div>
            </div>
        </div>

    </div>

    <!-- PROCESSING STATUS AND ACTIVE ALERTS -->
    <div class="row g-3 mb-4">

        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Processing Status
                    </h5>

                    <p>
                        <strong>Current mode:</strong>
                        <span class="badge bg-primary ms-2">
                            @processingMode.Mode
                        </span>
                    </p>

                    <p class="mb-0 text-muted">
                        @if (processingMode.AutomaticProcessingEnabled)
                        {
                            <span>
                                Incoming telemetry is automatically
                                processed by the background worker.
                            </span>
                        }
                        else
                        {
                            <span>
                                Manual processing is enabled.
                                Queued jobs will wait for processing.
                            </span>
                        }
                    </p>

                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h5 class="fw-semibold mb-3">
                        Active Critical Alerts
                    </h5>

                    @if (processingStatus.ActiveAlerts.Count == 0)
                    {
                        <div class="alert alert-success mb-0">
                            No active critical alerts.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger mb-0">
                            <strong>
                                @processingStatus.ActiveAlerts.Count
                                active critical alert(s)
                            </strong>

                            <ul class="mb-0 mt-2">
                                @foreach (var mac in processingStatus.ActiveAlerts)
                                {
                                    <li>@mac</li>
                                }
                            </ul>
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

    <!-- SENSOR SEARCH AND FILTERING -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="fw-semibold mb-1">
                        Sensor Search &amp; Filtering
                    </h5>

                    <p class="text-muted mb-0">
                        Search sensors by MAC address or location,
                        filter by category, and identify active critical alerts.
                    </p>
                </div>

                <span class="badge bg-primary">
                    @FilteredSensors.Count of @sensors.Count sensors
                </span>
            </div>

            <div class="row g-3 mb-3">

                <!-- SEARCH INPUT -->
                <div class="col-lg-5">
                    <label for="sensorSearch"
                           class="form-label fw-semibold">
                        Search MAC Address or Location
                    </label>

                    <input id="sensorSearch"
                           class="form-control"
                           placeholder="e.g. Zone B or AA:BB:CC"
                           @bind="sensorSearchText"
                           @bind:event="oninput" />
                </div>

                <!-- CATEGORY FILTER -->
                <div class="col-lg-4">
                    <label for="sensorCategory"
                           class="form-label fw-semibold">
                        Sensor Category
                    </label>

                    <select id="sensorCategory"
                            class="form-select"
                            @bind="selectedSensorCategory">

                        <option value="All">All Categories</option>

                        @foreach (var category in AvailableSensorCategories)
                        {
                            <option value="@category">
                                @category
                            </option>
                        }

                    </select>
                </div>

                <!-- ACTIVE ALERT FILTER -->
                <div class="col-lg-3 d-flex align-items-end">
                    <div class="form-check mb-2">

                        <input id="activeAlertsOnly"
                               class="form-check-input"
                               type="checkbox"
                               @bind="showActiveAlertsOnly" />

                        <label for="activeAlertsOnly"
                               class="form-check-label">
                            Active Alerts Only
                        </label>

                    </div>
                </div>

            </div>

            <!-- SEARCH HISTORY ACTIONS -->
            <div class="d-flex flex-wrap justify-content-end gap-2 mb-3">

                <button class="btn btn-primary"
                        disabled="@(isRecordingSearch || isLoading || !HasActiveSearchFilters)"
                        @onclick="RecordSensorSearchAsync">
                    @(isRecordingSearch ? "Recording..." : "Record Search")
                </button>

                <button class="btn btn-outline-secondary"
                        disabled="@isRecordingSearch"
                        @onclick="ResetSensorFilters">
                    Reset Filters
                </button>

            </div>

            @if (!string.IsNullOrWhiteSpace(searchHistoryMessage))
            {
                <div class="alert alert-success" role="status">
                    @searchHistoryMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(searchHistoryError))
            {
                <div class="alert alert-danger" role="alert">
                    @searchHistoryError
                </div>
            }

            <p class="text-muted small">
                Filtering happens instantly. Click
                <strong>Record Search</strong> to save your completed
                search and its results for historical analysis.
            </p>

            <!-- FILTERED SENSOR RESULTS -->
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>MAC Address</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Critical Alert</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (FilteredSensors.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No sensors match the selected filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var sensor in FilteredSensors)
                            {
                                bool hasAlert =
                                    processingStatus.ActiveAlerts.Contains(
                                        sensor.MacAddress,
                                        StringComparer.OrdinalIgnoreCase);

                                <tr>
                                    <td>
                                        <code>@sensor.MacAddress</code>
                                    </td>

                                    <td>@sensor.Category</td>

                                    <td>@sensor.Location</td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @sensor.Status
                                        </span>
                                    </td>

                                    <td>
                                        @if (hasAlert)
                                        {
                                            <span class="badge bg-danger">
                                                Critical
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                None
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <!-- PREDICTIVE ACTION AND RECOMMENDATION ENGINE -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <h5 class="fw-semibold mb-1">
                        Suggested Actions &amp; Automated Insights
                    </h5>

                    <p class="text-muted mb-0">
                        Evidence-based recommendations generated from
                        sensor conditions, device states and command history.
                    </p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge bg-primary">
                        @recommendations.Count recommendations
                    </span>

                    <button class="btn btn-outline-primary btn-sm"
                            disabled="@(isLoading || isCommandBusy || isRefreshingInsights)"
                            @onclick="RefreshRecommendationsAsync">
                        @(isRefreshingInsights ? "Refreshing..." : "Refresh Insights")
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(recommendationError))
            {
                <div class="alert alert-warning">
                    @recommendationError
                </div>
            }

            @if (recommendations.Count == 0 &&
                string.IsNullOrWhiteSpace(recommendationError))
            {
                <div class="alert alert-success mb-0">
                    <strong>
                        No recommendations currently require attention.
                    </strong>

                    <p class="mb-0 mt-2">
                        Recommendations will appear when the engine
                        identifies relevant sensor conditions or
                        patterns in device command history.
                    </p>
                </div>
            }
            else
            {
                <div class="row g-3">

                    @foreach (var recommendation in recommendations)
                    {
                        <div class="col-lg-6">
                            <div class="card h-100 border">

                                <div class="card-body">

                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">

                                        <h6 class="fw-bold mb-0">
                                            @recommendation.Title
                                        </h6>

                                        <span class="badge @GetRecommendationBadgeClass(recommendation.Severity)">
                                            @recommendation.Severity
                                        </span>

                                    </div>

                                    <p>
                                        @recommendation.Description
                                    </p>

                                    <p class="mb-2">
                                        <strong>Sensor:</strong>
                                        <code>@recommendation.MacAddress</code>
                                    </p>

                                    <div class="alert alert-info mb-3">
                                        <strong>Suggested Action</strong>

                                        <p class="mb-0 mt-1">
                                            @recommendation.RecommendedAction
                                        </p>
                                    </div>

                                    <div class="border-top pt-3">
                                        <p class="mb-1">
                                            <strong>Evidence / Reason</strong>
                                        </p>

                                        <p class="text-muted small mb-2">
                                            @recommendation.Reason
                                        </p>

                                        <small class="text-muted">
                                            Generated:
                                            @recommendation.GeneratedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")
                                        </small>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }

                </div>
            }

            <div class="border-top mt-3 pt-3">
                <p class="text-muted small mb-0">
                    These insights are advisory only. Smart-X does not
                    automatically execute device commands from recommendations.
                    Operators must assess conditions before taking action.
                </p>
            </div>

        </div>
    </div>

    <!-- DEVICE CONTROL PANEL -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-semibold mb-3">
                Device Control Panel
            </h5>

            <p class="text-muted">
                Select a registered sensor to control its
                simulated pump and relay devices.
            </p>

            <div class="row g-3">
                <div class="col-md-6">

                    <label for="deviceSensor"
                           class="form-label fw-semibold">
                        Select Sensor
                    </label>

                    <select id="deviceSensor"
                            class="form-select"
                            disabled="@(isLoading || isCommandBusy)"
                            @bind="selectedSensorMac">

                        <option value="">
                            -- Select a registered sensor --
                        </option>

                        @foreach (var sensor in sensors)
                        {
                            <option value="@sensor.MacAddress">
                                @sensor.MacAddress —
                                @sensor.Location
                                (@sensor.Category)
                            </option>
                        }

                    </select>

                </div>
            </div>

            @if (sensors.Count == 0)
            {
                <div class="alert alert-info mt-3 mb-0">
                    No registered sensors available.
                    Register a sensor from the Sensor Telemetry
                    page before using device controls.
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(selectedSensorMac))
            {
                <div class="row g-3 mt-2">

                    <!-- PUMP CONTROL -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">

                            <h6 class="fw-bold">Pump Control</h6>

                            <p>
                                <strong>Current state:</strong>
                                <span class="badge @(GetDeviceState("Pump") == "ON" ? "bg-success" : "bg-secondary")">
                                    @GetDeviceState("Pump")
                                </span>
                            </p>

                            <p class="text-muted">
                                Control the simulated water pump.
                            </p>

                            <button class="btn btn-success me-2 mb-2"
                                    disabled="@(isCommandBusy || isLoading)"
                                    @onclick='() => SendDeviceCommandAsync("Pump", "ON")'>
                                Pump ON
                            </button>

                            <button class="btn btn-outline-danger mb-2"
                                    disabled="@(isCommandBusy || isLoading)"
                                    @onclick='() => SendDeviceCommandAsync("Pump", "OFF")'>
                                Pump OFF
                            </button>

                        </div>
                    </div>

                    <!-- RELAY CONTROL -->
                    <div class="col-md-6">
                        <div class="border rounded p-3 h-100">

                            <h6 class="fw-bold">Relay Control</h6>

                            <p>
                                <strong>Current state:</strong>
                                <span class="badge @(GetDeviceState("Relay") == "ON" ? "bg-success" : "bg-secondary")">
                                    @GetDeviceState("Relay")
                                </span>
                            </p>

                            <p class="text-muted">
                                Control the simulated relay switch.
                            </p>

                            <button class="btn btn-success me-2 mb-2"
                                    disabled="@(isCommandBusy || isLoading)"
                                    @onclick='() => SendDeviceCommandAsync("Relay", "ON")'>
                                Relay ON
                            </button>

                            <button class="btn btn-outline-danger mb-2"
                                    disabled="@(isCommandBusy || isLoading)"
                                    @onclick='() => SendDeviceCommandAsync("Relay", "OFF")'>
                                Relay OFF
                            </button>

                        </div>
                    </div>

                </div>
            }

            <!-- COMMAND UNDO -->
            <div class="border-top mt-4 pt-3">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                    <div>
                        <h6 class="fw-bold mb-1">
                            Command Undo
                        </h6>

                        <p class="text-muted mb-2">
                            Reverse the most recently executed device command
                            using the global LIFO undo stack.
                        </p>

                        <span class="badge bg-secondary">
                            Available Undos: @commandStatus.UndoCount
                        </span>

                        <span class="badge bg-info text-dark ms-2">
                            History Records: @commandStatus.HistoryCount
                        </span>
                    </div>

                    <button class="btn btn-warning"
                            disabled="@(isCommandBusy || isLoading || !commandStatus.UndoAvailable)"
                            @onclick="UndoLastCommandAsync">
                        Undo Last Command
                    </button>

                </div>

            </div>

        </div>
    </div>

    <!-- DEVICE COMMAND HISTORY -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div>
                    <h5 class="fw-semibold mb-1">
                        Device Command History
                    </h5>

                    <p class="text-muted mb-0">
                        Audit trail of manual device commands and
                        LIFO undo operations.
                    </p>
                </div>

                <span class="badge bg-secondary">
                    @commandHistory.Count records
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Timestamp</th>
                            <th>Sensor MAC</th>
                            <th>Device</th>
                            <th>Action</th>
                            <th>Previous</th>
                            <th>New</th>
                            <th>Type</th>
                            <th>Reverses</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (commandHistory.Count == 0)
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center text-muted py-4">
                                    No device commands have been recorded yet.
                                    Execute a Pump or Relay command to begin.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var command in commandHistory
                                .OrderByDescending(x => x.Id)
                                .Take(30))
                            {
                                <tr>
                                    <td>
                                        <strong>#@command.Id</strong>
                                    </td>

                                    <td class="text-nowrap">
                                        @command.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")
                                    </td>

                                    <td>
                                        <code>@command.MacAddress</code>
                                    </td>

                                    <td>@command.DeviceType</td>

                                    <td>
                                        <span class="badge @(command.Action == "ON" ? "bg-success" : "bg-secondary")">
                                            @command.Action
                                        </span>
                                    </td>

                                    <td>@command.PreviousState</td>

                                    <td>@command.NewState</td>

                                    <td>
                                        @if (command.IsUndo)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Undo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                Manual
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (command.UndoesCommandId.HasValue)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                #@command.UndoesCommandId.Value
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

            <p class="text-muted small mb-0">
                Showing up to 30 most recent records.
                Undo operations remain in the audit history
                and reference the original command they reversed.
            </p>

        </div>
    </div>

    <!-- RECENT PROCESSED TELEMETRY -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-semibold mb-0">
                    Recent Processed Telemetry
                </h5>

                <span class="badge bg-secondary">
                    @telemetryHistory.Count records
                </span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>MAC Address</th>
                            <th>Data Type</th>
                            <th>Value</th>
                            <th>Priority</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (telemetryHistory.Count == 0)
                        {
                            <tr>
                                <td colspan="5"
                                    class="text-center text-muted py-4">
                                    No processed telemetry available.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var job in telemetryHistory
                                .OrderByDescending(x => x.Timestamp)
                                .ThenByDescending(x => x.Sequence)
                                .Take(15))
                            {
                                <tr>
                                    <td>
                                        @job.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")
                                    </td>

                                    <td>
                                        <code>@job.MacAddress</code>
                                    </td>

                                    <td>@job.DataType</td>

                                    <td>
                                        @job.Value @job.Unit
                                    </td>

                                    <td>
                                        @if (job.Priority == 0)
                                        {
                                            <span class="badge bg-danger">
                                                Critical
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Normal
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

@code {

    private const string ApiBaseUrl = "https://localhost:7199";

    private bool isLoading;
    private bool hasLoaded;
    private bool isCommandBusy;
    private bool isRefreshingInsights;

    // NEW: Search history submission state.
    private bool isRecordingSearch;

    private string errorMessage = string.Empty;
    private string commandMessage = string.Empty;
    private string recommendationError = string.Empty;

    // NEW: Search history feedback.
    private string searchHistoryMessage = string.Empty;
    private string searchHistoryError = string.Empty;

    private string selectedSensorMac = string.Empty;

    private List<SensorDto> sensors = new();

    // SENSOR SEARCH AND FILTER STATE
    private string sensorSearchText = string.Empty;
    private string selectedSensorCategory = "All";
    private bool showActiveAlertsOnly = false;

    // Only allow meaningful searches to be recorded.
    private bool HasActiveSearchFilters =>
        !string.IsNullOrWhiteSpace(sensorSearchText)
        || selectedSensorCategory != "All"
        || showActiveAlertsOnly;

    // AVAILABLE SENSOR CATEGORIES
    private IEnumerable<string> AvailableSensorCategories =>
        sensors
            .Select(sensor => sensor.Category)
            .Where(category => !string.IsNullOrWhiteSpace(category))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category);

    // COMBINED SENSOR FILTERING
    private List<SensorDto> FilteredSensors =>
        sensors
            .Where(sensor =>
                string.IsNullOrWhiteSpace(sensorSearchText)
                || sensor.MacAddress.Contains(
                    sensorSearchText.Trim(),
                    StringComparison.OrdinalIgnoreCase)
                || sensor.Location.Contains(
                    sensorSearchText.Trim(),
                    StringComparison.OrdinalIgnoreCase))
            .Where(sensor =>
                selectedSensorCategory == "All"
                || string.Equals(
                    sensor.Category,
                    selectedSensorCategory,
                    StringComparison.OrdinalIgnoreCase))
            .Where(sensor =>
                !showActiveAlertsOnly
                || processingStatus.ActiveAlerts.Contains(
                    sensor.MacAddress,
                    StringComparer.OrdinalIgnoreCase))
            .OrderBy(sensor => sensor.MacAddress)
            .ToList();

    // RESET ALL SENSOR FILTERS
    private void ResetSensorFilters()
    {
        sensorSearchText = string.Empty;
        selectedSensorCategory = "All";
        showActiveAlertsOnly = false;

        searchHistoryMessage = string.Empty;
        searchHistoryError = string.Empty;
    }

    // NEW: RECORD A DELIBERATE SENSOR SEARCH
    private async Task RecordSensorSearchAsync()
    {
        if (isRecordingSearch || isLoading)
        {
            return;
        }

        searchHistoryMessage = string.Empty;
        searchHistoryError = string.Empty;

        if (!HasActiveSearchFilters)
        {
            searchHistoryError =
                "Enter a search term or select a filter before recording.";
            return;
        }

        isRecordingSearch = true;

        try
        {
            string searchTerm = sensorSearchText.Trim();
            string category = selectedSensorCategory;
            bool activeAlertsOnly = showActiveAlertsOnly;
            int resultCount = FilteredSensors.Count;

            var request = new
            {
                SearchTerm = searchTerm,
                Category = category,
                ActiveAlertsOnly = activeAlertsOnly,
                ResultCount = resultCount
            };

            using var response = await Http.PostAsJsonAsync(
                $"{ApiBaseUrl}/api/search-history",
                request);

            if (response.IsSuccessStatusCode)
            {
                searchHistoryMessage =
                    $"Search recorded successfully. " +
                    $"{resultCount} sensor(s) matched the selected criteria.";

                return;
            }

            searchHistoryError =
                "Unable to record the search. " +
                $"API returned HTTP {(int)response.StatusCode}.";
        }
        catch (Exception ex)
        {
            searchHistoryError =
                "Unable to record the search. " +
                "Check that SmartX.Api is running. " +
                ex.Message;
        }
        finally
        {
            isRecordingSearch = false;
        }
    }

    private ProcessingStatusDto processingStatus = new();
    private ProcessingModeDto processingMode = new();
    private List<TelemetryJobDto> telemetryHistory = new();

    private CommandStatusDto commandStatus = new();
    private List<DeviceCommandDto> commandHistory = new();

    // PREDICTIVE RECOMMENDATIONS
    private List<DeviceRecommendationDto> recommendations = new();

    // Device states keyed by MAC address and device type.
    private Dictionary<string, string> deviceStates = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    // RECOMMENDATION SEVERITY COLOURS
    private string GetRecommendationBadgeClass(string severity)
    {
        return severity.ToLowerInvariant() switch
        {
            "critical" => "bg-danger",
            "warning" => "bg-warning text-dark",
            "info" => "bg-info text-dark",
            _ => "bg-secondary"
        };
    }

    // RETRIEVE RECOMMENDATIONS FROM THE API
    private async Task RefreshRecommendationsAsync()
    {
        if (isRefreshingInsights)
        {
            return;
        }

        isRefreshingInsights = true;
        recommendationError = string.Empty;

        try
        {
            var response =
                await Http.GetFromJsonAsync<RecommendationsResponseDto>(
                    $"{ApiBaseUrl}/api/recommendations");

            recommendations =
                response?.Recommendations
                ?? new List<DeviceRecommendationDto>();
        }
        catch (Exception ex)
        {
            recommendationError =
                "Unable to load recommendations. " +
                "Check that SmartX.Api is running. " +
                ex.Message;
        }
        finally
        {
            isRefreshingInsights = false;
        }
    }

    private string GetDeviceState(string deviceType)
    {
        if (string.IsNullOrWhiteSpace(selectedSensorMac))
        {
            return "OFF";
        }

        string key =
            $"{selectedSensorMac}|{deviceType.ToUpperInvariant()}";

        return deviceStates.TryGetValue(key, out var state)
            ? state
            : "OFF";
    }

    // Retrieve the LIFO undo stack and audit history counts.
    private async Task RefreshCommandStatusAsync()
    {
        var result =
            await Http.GetFromJsonAsync<CommandStatusDto>(
                $"{ApiBaseUrl}/api/commands/status");

        commandStatus = result ?? new CommandStatusDto();
    }

    // Retrieve the command audit history from the backend.
    private async Task RefreshCommandHistoryAsync()
    {
        var result =
            await Http.GetFromJsonAsync<List<DeviceCommandDto>>(
                $"{ApiBaseUrl}/api/commands/history");

        commandHistory = result ?? new List<DeviceCommandDto>();
    }

    // Execute a manual Pump or Relay command.
    private async Task SendDeviceCommandAsync(
        string deviceType,
        string action)
    {
        if (isCommandBusy || isLoading)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedSensorMac))
        {
            commandMessage = string.Empty;
            errorMessage = "Please select a registered sensor first.";
            return;
        }

        isCommandBusy = true;
        commandMessage = string.Empty;
        errorMessage = string.Empty;

        try
        {
            var request = new DeviceCommandRequest
            {
                MacAddress = selectedSensorMac,
                DeviceType = deviceType,
                Action = action
            };

            using var response = await Http.PostAsJsonAsync(
                $"{ApiBaseUrl}/api/commands",
                request);

            if (response.IsSuccessStatusCode)
            {
                var updatedStates =
                    await Http.GetFromJsonAsync<Dictionary<string, string>>(
                        $"{ApiBaseUrl}/api/commands/states");

                deviceStates = updatedStates ?? new();

                await RefreshCommandStatusAsync();
                await RefreshCommandHistoryAsync();
                await RefreshRecommendationsAsync();

                commandMessage =
                    $"{deviceType} {action} executed successfully " +
                    $"for sensor {selectedSensorMac}.";

                return;
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.Conflict)
            {
                errorMessage =
                    $"The {deviceType} command was rejected. " +
                    "The device may already be in the requested state.";

                return;
            }

            errorMessage =
                $"Unable to execute {deviceType} {action}. " +
                $"API returned HTTP {(int)response.StatusCode}.";
        }
        catch (Exception ex)
        {
            errorMessage =
                "Unable to send the device command. " +
                "Check that SmartX.Api is running. " +
                ex.Message;
        }
        finally
        {
            isCommandBusy = false;
        }
    }

    // Reverse the most recent device command using LIFO.
    private async Task UndoLastCommandAsync()
    {
        if (isCommandBusy || isLoading)
        {
            return;
        }

        isCommandBusy = true;
        commandMessage = string.Empty;
        errorMessage = string.Empty;

        try
        {
            using var response = await Http.PostAsync(
                $"{ApiBaseUrl}/api/commands/undo",
                null);

            if (response.IsSuccessStatusCode)
            {
                var updatedStates =
                    await Http.GetFromJsonAsync<Dictionary<string, string>>(
                        $"{ApiBaseUrl}/api/commands/states");

                deviceStates = updatedStates ?? new();

                await RefreshCommandStatusAsync();
                await RefreshCommandHistoryAsync();
                await RefreshRecommendationsAsync();

                commandMessage =
                    "Last device command successfully undone. " +
                    "The previous device state has been restored.";

                return;
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.Conflict)
            {
                await RefreshCommandStatusAsync();

                errorMessage =
                    "No commands are available to undo. " +
                    "The undo stack is empty.";

                return;
            }

            errorMessage =
                "Unable to undo the last command. " +
                $"API returned HTTP {(int)response.StatusCode}.";
        }
        catch (Exception ex)
        {
            errorMessage =
                "Unable to undo the last command. " +
                "Check that SmartX.Api is running. " +
                ex.Message;
        }
        finally
        {
            isCommandBusy = false;
        }
    }

    // Refresh telemetry, device states, command history and insights.
    private async Task LoadDashboardAsync()
    {
        if (isLoading || isCommandBusy)
        {
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var sensorResult =
                await Http.GetFromJsonAsync<List<SensorDto>>(
                    $"{ApiBaseUrl}/api/sensors");

            var statusResult =
                await Http.GetFromJsonAsync<ProcessingStatusDto>(
                    $"{ApiBaseUrl}/api/processing/status");

            var modeResult =
                await Http.GetFromJsonAsync<ProcessingModeDto>(
                    $"{ApiBaseUrl}/api/processing/mode");

            var historyResult =
                await Http.GetFromJsonAsync<List<TelemetryJobDto>>(
                    $"{ApiBaseUrl}/api/processing/history");

            var deviceStatesResult =
                await Http.GetFromJsonAsync<Dictionary<string, string>>(
                    $"{ApiBaseUrl}/api/commands/states");

            sensors = sensorResult ?? new();
            processingStatus = statusResult ?? new();
            processingMode = modeResult ?? new();
            telemetryHistory = historyResult ?? new();
            deviceStates = deviceStatesResult ?? new();

            await RefreshCommandStatusAsync();
            await RefreshCommandHistoryAsync();
            await RefreshRecommendationsAsync();

            // Preserve selected sensor if it remains registered.
            if (!string.IsNullOrWhiteSpace(selectedSensorMac) &&
                !sensors.Any(sensor =>
                    string.Equals(
                        sensor.MacAddress,
                        selectedSensorMac,
                        StringComparison.OrdinalIgnoreCase)))
            {
                selectedSensorMac = string.Empty;
            }

            hasLoaded = true;
        }
        catch (Exception ex)
        {
            errorMessage =
                "Unable to load Smart-X dashboard. " +
                "Check that SmartX.Api is running. " +
                ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

