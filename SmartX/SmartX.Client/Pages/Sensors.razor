@page "/sensors"
@using SmartX.Client.Models
@inject HttpClient Http

<PageTitle>Smart-X Sensors</PageTitle>

<div class="container-fluid py-4 px-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Smart-X Sensor Dashboard
            </h1>

            <p class="text-muted mb-0">
                Live sensor monitoring, anomaly detection and encrypted attachment tracking.
            </p>
        </div>

        <a href="/register-sensor"
           class="btn btn-primary btn-lg">
            + Register New Sensor
        </a>

    </div>

    <!-- STATUS CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold">
                        Total Sensors
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @SensorList.Count
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-success">
                        Normal
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @SensorList.Count(s => s.Status == "Normal")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-warning">
                        Warnings
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @SensorList.Count(s => s.Status == "Warning")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-danger">
                        Critical
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @SensorList.Count(s => s.Status == "Critical")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="fw-bold text-secondary">
                        Offline
                    </h6>

                    <h2 class="fw-bold mb-0">
                        @SensorList.Count(s => s.Status == "Offline")
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- REGISTERED SENSOR SECTION -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h3 class="fw-bold mb-0">
                    Registered Sensors
                </h3>

                <a href="/register-sensor"
                   class="btn btn-success">
                    + Register Sensor
                </a>

            </div>

            <!-- FILTERS -->
            <div class="row g-3 mb-4">

                <div class="col-md-6">

                    <input class="form-control"
                           placeholder="Search MAC address, location, category or status"
                           @bind="SearchText"
                           @bind:event="oninput" />

                </div>

                <div class="col-md-3">

                    <select class="form-select"
                            @bind="SelectedCategory">

                        <option value="">
                            All Categories
                        </option>

                        <option value="Temperature">
                            Temperature
                        </option>

                        <option value="Humidity">
                            Humidity
                        </option>

                        <option value="Pressure">
                            Pressure
                        </option>

                        <option value="Air Quality">
                            Air Quality
                        </option>

                        <option value="Motion">
                            Motion
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <select class="form-select"
                            @bind="SelectedStatus">

                        <option value="">
                            All Statuses
                        </option>

                        <option value="Normal">
                            Normal
                        </option>

                        <option value="Warning">
                            Warning
                        </option>

                        <option value="Critical">
                            Critical
                        </option>

                        <option value="Offline">
                            Offline
                        </option>

                    </select>

                </div>

            </div>

            @if (isLoading)
            {
                <div class="alert alert-info">
                    Loading Smart-X sensor information...
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }
            else if (!FilteredSensors.Any())
            {
                <div class="alert alert-info mb-0">
                    No sensors are currently registered.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>MAC Address</th>
                                <th>Location</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Last Seen</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (SensorRecord sensor in FilteredSensors)
                            {
                                <tr>

                                    <td>
                                        @sensor.Id
                                    </td>

                                    <td>
                                        <code>
                                            @sensor.MacAddress
                                        </code>
                                    </td>

                                    <td>
                                        @sensor.Location
                                    </td>

                                    <td>
                                        @sensor.Category
                                    </td>

                                    <td>
                                        <span class="@GetStatusClass(sensor.Status)">
                                            @sensor.Status
                                        </span>
                                    </td>

                                    
                                    <td>
                                        @(sensor.LastSeen.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))
                                    </td>


                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <!-- ATTACHMENTS -->
    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <h3 class="fw-bold mb-3">
                Encrypted Sensor Attachments
            </h3>

            @if (Attachments.Count == 0)
            {
                <div class="alert alert-secondary mb-0">
                    No sensor attachments have been uploaded.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Sensor</th>
                                <th>Original File</th>
                                <th>Stored File</th>
                                <th>Content Type</th>
                                <th>Uploaded</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (SensorAttachment attachment in Attachments)
                            {
                                <tr>

                                    <td>
                                        @attachment.Id
                                    </td>

                                    <td>
                                        <code>
                                            @attachment.SensorMacAddress
                                        </code>
                                    </td>

                                    <td>
                                        @attachment.OriginalFileName
                                    </td>

                                    <td>
                                        @attachment.StoredFileName
                                    </td>

                                    <td>
                                        @attachment.ContentType
                                    </td>

                                    <td>
                                        @attachment.UploadedAt
                                        .ToLocalTime()
                                        .ToString("yyyy-MM-dd HH:mm:ss")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

@code {

    private List<SensorRecord> SensorList { get; set; } = new();

    private List<SensorAttachment> Attachments { get; set; } = new();

    private string SearchText { get; set; } = string.Empty;

    private string SelectedCategory { get; set; } = string.Empty;

    private string SelectedStatus { get; set; } = string.Empty;

    private bool isLoading = true;

    private string errorMessage = string.Empty;


    private IEnumerable<SensorRecord> FilteredSensors
    {
        get
        {
            IEnumerable<SensorRecord> result = SensorList;

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                result = result.Where(sensor =>
                    sensor.MacAddress.Contains(
                        SearchText,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    sensor.Location.Contains(
                        SearchText,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    sensor.Category.Contains(
                        SearchText,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    sensor.Status.Contains(
                        SearchText,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedCategory))
            {
                result = result.Where(sensor =>
                    sensor.Category.Equals(
                        SelectedCategory,
                        StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(SelectedStatus))
            {
                result = result.Where(sensor =>
                    sensor.Status.Equals(
                        SelectedStatus,
                        StringComparison.OrdinalIgnoreCase));
            }

            return result;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }


    private async Task LoadDashboardAsync()
    {
        try
        {
            isLoading = true;

            errorMessage = string.Empty;

            SensorList =
                await Http.GetFromJsonAsync<List<SensorRecord>>(
                    "api/sensors")
                ?? new List<SensorRecord>();

            Attachments =
                await Http.GetFromJsonAsync<List<SensorAttachment>>(
                    "api/attachments")
                ?? new List<SensorAttachment>();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load Smart-X data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private static string GetStatusClass(string status)
    {
        return status switch
        {
            "Normal" =>
                "badge bg-success",

            "Warning" =>
                "badge bg-warning text-dark",

            "Critical" =>
                "badge bg-danger",

            "Offline" =>
                "badge bg-secondary",

            _ =>
                "badge bg-dark"
        };
    }
}