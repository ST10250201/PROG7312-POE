@page "/sensors"
@using SmartX.Client.Models
@inject HttpClient Http

<PageTitle>Smart-X Sensors</PageTitle>

<h1>Smart-X Sensor Dashboard</h1>

<p>Live sensor records retrieved from the Smart-X Minimal API.</p>

@if (isLoading)
{
    <p>Loading Smart-X data...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else
{
    <!-- Summary Cards -->
    <div class="row mb-4">
        <div class="col">
            <div class="card p-3">
                <strong>Total Sensors</strong>
                <h3>@sensors.Count</h3>
            </div>
        </div>

        <div class="col">
            <div class="card p-3">
                <strong>Normal</strong>
                <h3>@sensors.Count(s => s.Status == "Normal")</h3>
            </div>
        </div>

        <div class="col">
            <div class="card p-3">
                <strong>Warnings</strong>
                <h3>@sensors.Count(s => s.Status == "Warning")</h3>
            </div>
        </div>

        <div class="col">
            <div class="card p-3">
                <strong>Critical</strong>
                <h3>@sensors.Count(s => s.Status == "Critical")</h3>
            </div>
        </div>

        <div class="col">
            <div class="card p-3">
                <strong>Offline</strong>
                <h3>@sensors.Count(s => s.Status == "Offline")</h3>
            </div>
        </div>
    </div>

    <h3>Registered Sensors</h3>

    <!-- Search and Filtering -->
    <div class="row mb-3">

        <div class="col-md-6">
            <input class="form-control"
                   @bind="searchTerm"
                   @bind:event="oninput"
                   placeholder="Search MAC address, location, category or status" />
        </div>

        <div class="col-md-3">
            <select class="form-select"
                    @bind="selectedCategory">

                <option value="">All Categories</option>

                @foreach (var category in SensorCategories)
                {
                    <option value="@category">
                        @category
                    </option>
                }

            </select>
        </div>

        <div class="col-md-3">
            <select class="form-select"
                    @bind="selectedStatus">

                <option value="">All Statuses</option>
                <option value="Normal">Normal</option>
                <option value="Warning">Warning</option>
                <option value="Critical">Critical</option>
                <option value="Offline">Offline</option>

            </select>
        </div>

    </div>

    @if (sensors.Count == 0)
    {
        <div class="alert alert-info">
            No sensors are currently registered.
        </div>
    }
    else if (!FilteredSensors.Any())
    {
        <div class="alert alert-warning">
            No sensors match the selected filters.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>MAC Address</th>
                        <th>Location</th>
                        <th>Category</th>
                        <th>Status</th>
                        <th>Last Seen</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var sensor in FilteredSensors)
                    {
                        <tr>

                            <td>@sensor.Id</td>

                            <td>@sensor.MacAddress</td>

                            <td>@sensor.Location</td>

                            <td>@sensor.Category</td>

                            <td>
                                <span class="@GetStatusClass(sensor.Status)">
                                    @sensor.Status
                                </span>
                            </td>

                            <td>
                                @sensor.LastSeen
                                .ToLocalTime()
                                .ToString("yyyy-MM-dd HH:mm:ss")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        </div>
    }

    <hr />

    <h3>Encrypted Sensor Attachments</h3>

    @if (attachments.Count == 0)
    {
        <div class="alert alert-secondary">
            No sensor attachments have been uploaded.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered align-middle">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Sensor MAC</th>
                        <th>Original File</th>
                        <th>Content Type</th>
                        <th>File Size</th>
                        <th>Uploaded</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var attachment in attachments)
                    {
                        <tr>

                            <td>@attachment.Id</td>

                            <td>@attachment.SensorMacAddress</td>

                            <td>@attachment.OriginalFileName</td>

                            <td>@attachment.ContentType</td>

                            <td>@FormatFileSize(attachment.FileSize)</td>

                            <td>
                                @attachment.UploadedAt
                                .ToLocalTime()
                                .ToString("yyyy-MM-dd HH:mm:ss")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
}

@code {

    private List<SensorRecord> sensors = new();

    private List<SensorAttachment> attachments = new();

    private bool isLoading = true;

    private string errorMessage = string.Empty;

    private string searchTerm = string.Empty;

    private string selectedCategory = string.Empty;

    private string selectedStatus = string.Empty;


    private IEnumerable<string> SensorCategories =>
        sensors
            .Select(s => s.Category)
            .Distinct()
            .OrderBy(c => c);


    private IEnumerable<SensorRecord> FilteredSensors =>
        sensors.Where(sensor =>
        {
            bool matchesSearch =
                string.IsNullOrWhiteSpace(searchTerm) ||

                sensor.MacAddress.Contains(
                    searchTerm,
                    StringComparison.OrdinalIgnoreCase) ||

                sensor.Location.Contains(
                    searchTerm,
                    StringComparison.OrdinalIgnoreCase) ||

                sensor.Category.Contains(
                    searchTerm,
                    StringComparison.OrdinalIgnoreCase) ||

                sensor.Status.Contains(
                    searchTerm,
                    StringComparison.OrdinalIgnoreCase);


            bool matchesCategory =
                string.IsNullOrWhiteSpace(selectedCategory) ||

                sensor.Category.Equals(
                    selectedCategory,
                    StringComparison.OrdinalIgnoreCase);


            bool matchesStatus =
                string.IsNullOrWhiteSpace(selectedStatus) ||

                sensor.Status.Equals(
                    selectedStatus,
                    StringComparison.OrdinalIgnoreCase);


            return matchesSearch &&
                   matchesCategory &&
                   matchesStatus;
        });


    protected override async Task OnInitializedAsync()
    {
        try
        {
            sensors =
                await Http.GetFromJsonAsync<List<SensorRecord>>(
                    "api/sensors")
                ?? new List<SensorRecord>();

            attachments =
                await Http.GetFromJsonAsync<List<SensorAttachment>>(
                    "api/attachments")
                ?? new List<SensorAttachment>();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load Smart-X data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }


    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Normal" =>
                "badge bg-success",

            "Warning" =>
                "badge bg-warning text-dark",

            "Critical" =>
                "badge bg-danger",

            "Offline" =>
                "badge bg-secondary",

            _ =>
                "badge bg-light text-dark"
        };
    }


    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        return $"{bytes / 1024.0:F1} KB";
    }
}