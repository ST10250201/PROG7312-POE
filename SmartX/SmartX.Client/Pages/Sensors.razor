@page "/sensors"
@using SmartX.Client.Models
@inject HttpClient Http

<PageTitle>Smart-X Sensors</PageTitle>

<h1>Smart-X Sensor Dashboard</h1>

<p>
    Live sensor records retrieved from the Smart-X Minimal API.
</p>

@if (isLoading)
{
    <p>Loading sensors...</p>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else if (sensors.Count == 0)
{
    <div class="alert alert-info">
        No sensors are currently registered.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>MAC Address</th>
                    <th>Location</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Last Seen</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var sensor in sensors)
                {
                    <tr>
                        <td>@sensor.Id</td>
                        <td>@sensor.MacAddress</td>
                        <td>@sensor.Location</td>
                        <td>@sensor.Category</td>
                        <td>
                            <span class="@GetStatusClass(sensor.Status)">
                                @sensor.Status
                            </span>
                        </td>
                        <td>@sensor.LastSeen.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<SensorRecord> sensors = new();
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sensors =
                await Http.GetFromJsonAsync<List<SensorRecord>>("api/sensors")
                ?? new List<SensorRecord>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load sensor data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Normal" => "badge bg-success",
            "Warning" => "badge bg-warning text-dark",
            "Critical" => "badge bg-danger",
            "Offline" => "badge bg-secondary",
            _ => "badge bg-light text-dark"
        };
    }
}