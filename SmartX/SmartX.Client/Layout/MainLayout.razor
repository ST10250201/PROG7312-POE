@inherits LayoutComponentBase

<div class="min-vh-100 bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container-fluid px-4">
            <NavLink class="navbar-brand fw-bold" href="/" Match="NavLinkMatch.All">
                Smart-X
            </NavLink>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#smartxNavigation"
                    aria-controls="smartxNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="smartxNavigation">
                <div class="navbar-nav ms-auto gap-lg-2">
                    <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                        Home
                    </NavLink>

                    <NavLink class="nav-link" href="/sensors">
                        Sensor Telemetry
                    </NavLink>

                    <NavLink class="nav-link" href="/command-stream">
                        Command Stream &amp; History
                    </NavLink>

                    <NavLink class="nav-link" href="/network-topology">
                        Network Topology
                    </NavLink>
                </div>
            </div>
        </div>
    </nav>

    <main class="container-fluid px-4 py-4">
        @Body
    </main>

    <footer class="border-top bg-white py-3 mt-4">
        <div class="container-fluid px-4">
            <small class="text-muted">
                Smart-X IoT Management Platform | PROG7312
            </small>
        </div>
    </footer>
</div>
