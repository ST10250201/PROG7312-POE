@model IEnumerable<SmartX.Web.Models.Sensor>

@{
    ViewData["Title"] = "Registered Sensors";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Registered Sensors</h2>
            <p class="text-muted mb-0">
                Sensors currently registered with the Smart-X Gateway.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Register New Sensor
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No sensors have been registered yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>MAC Address</th>
                                <th>Location</th>
                                <th>Category</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var sensor in Model)
                            {
                                <tr>
                                    <td>@sensor.Id</td>
                                    <td>@sensor.MacAddress</td>
                                    <td>@sensor.Location</td>
                                    <td>@sensor.Category</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>